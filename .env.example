# --- Storage ---------------------------------------------------------------
# Postgres connection string. On Supabase use the transaction pooler (port 6543),
# which Vercel can reach over IPv4. Leave unset to use a local PGlite database
# in data/pglite (no server needed).
DATABASE_URL=
# DATABASE_PATH=data/pglite

# --- Model routing -----------------------------------------------------------
# Every model is addressed as "<provider>:<model-id>". Each role can list
# several models separated by commas: the first is primary, the rest are
# fallbacks (extraction) or co-judges (judging, see JUDGE_POLICY).
#
# Providers: anthropic, openai, gemini, openrouter, groq, together, deepseek,
#            mistral, fireworks, xai, ollama, lmstudio, vllm
MODEL_EXTRACT=anthropic:claude-sonnet-5
MODEL_JUDGE=anthropic:claude-sonnet-5
# JUDGE_POLICY: "primary" (first judge only) | "unanimous" (all judges must
# agree a conflict exists; best precision) | "majority"
JUDGE_POLICY=primary
JUDGE_CONFIDENCE_THRESHOLD=0.7

# Kept for compatibility with the PoC spec: if set, overrides the model id used
# for the default anthropic routes.
ANTHROPIC_MODEL=

# --- Provider credentials (only the ones you route to are needed) ------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
OPEN_ROUTER_LLM_KEY=   # same as OPENROUTER_API_KEY; either name works
# Local open-weight servers (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1
